    "use_constraints_for_candidate_scoring": true
  },
  "synthetic_factory": {
    "suite": "smoke",
    "seed": 1234,
    "output_root": "temp/synthetic",
    "commit_small_fixtures_only": true,
    "keep_heavy_artifacts": false
  },
  "quality_budget": {
    "budget_json": null,
    "compare_baseline": null,
    "fail_on_regression": false,
    "environment_compatibility": "warn"
  },
  "refinement_lab": {
    "default_output_root": "temp/refinement-runs",
    "default_suite": "default-vase",
    "default_track": "profile-loft-refinement",
    "default_search": "grid",
    "default_objective": "quality_win",
    "max_runs": null,
    "top_k": 10,
    "html_report": true,
    "write_overlays": true,
    "write_bounds_debug": true,
    "write_autopsy": true,
    "append_leaderboard": true,
    "fail_on_all_failed": true,
    "allow_subprocess_blender": false,
