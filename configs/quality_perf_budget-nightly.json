{
  "$schema": "./quality_perf_budget.schema.json",
  "schema_version": "quality_perf_budget_v1",
  "name": "nightly",
  "description": "Broad nightly budgets. These are intentionally generous absolute limits; baseline comparisons catch most regressions.",
  "thresholds": [
    {
      "id": "bench.nightly.rows.ok",
      "artifact": "benchmark",
      "case": "nightly",
      "metric": "metrics.status_ok",
      "mode": "min",
      "threshold": 1.0,
      "required": true
    },
    {
      "id": "bench.nightly.visual_hull.max_ms",
      "artifact": "benchmark",
      "case": "nightly",
      "name": "visual_hull_reconstruct",
      "metric": "metrics.per_iter_ms",
      "mode": "max",
      "threshold": 5000.0,
      "required": true
    },
    {
      "id": "bench.nightly.target_builder.max_ms",
      "artifact": "benchmark",
      "case": "nightly",
      "name": "target_builder",
      "metric": "metrics.per_iter_ms",
      "mode": "max",
      "threshold": 500.0,
      "required": true
    },
    {
      "id": "e2e.nightly.rows.pass",
      "artifact": "e2e",
      "metric": "metrics.passed",
      "mode": "min",
      "threshold": 1.0,
      "required": true
    },
    {
      "id": "e2e.nightly.render_iou.floor",
      "artifact": "e2e",
      "metric": "metrics.average_iou",
      "mode": "min",
      "threshold": 0.6,
      "required": false
    }
  ],
  "comparisons": [
    {
      "id": "bench.nightly.per_iter.regression_pct",
      "artifact": "benchmark",
      "case": "nightly",
      "metric": "metrics.per_iter_ms",
      "mode": "max_percent_increase",
      "threshold": 15.0,
      "required": false
    },
    {
      "id": "e2e.nightly.iou.regression_abs",
      "artifact": "e2e",
      "metric": "metrics.average_iou",
      "mode": "max_absolute_decrease",
      "threshold": 0.02,
      "required": false
    }
  ]
}
